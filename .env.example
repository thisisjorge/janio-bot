# Obrigatório: Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=cole_o_token_aqui

# A política da Riot proíbe betting/gambling em produtos do ecossistema.
# community: pontos e previsões; não carrega os comandos /lol.
# league: builds, runas e perfis; não carrega os comandos /aposta.
JANIO_MODE=community

# Opcional: sincroniza comandos imediatamente só no servidor de desenvolvimento.
# Use o ID do servidor; deixe vazio para sincronização global.
TEST_GUILD_ID=

# Opcional: necessário apenas para /lol jogador.
# Gere em https://developer.riotgames.com/
RIOT_API_KEY=

DATABASE_PATH=data/janio.sqlite3
DEFAULT_POINTS=1000
DAILY_POINTS=250
DEFAULT_ANNOUNCEMENT_INTERVAL_SECONDS=210
DEFAULT_ANNOUNCEMENT_MESSAGE=Hora do palpite!
FFMPEG_PATH=ffmpeg
SYNC_COMMANDS=true
LOG_LEVEL=INFO
